{
  "compilerOptions": {
    // ES2022, matching the Node floor in package.json (^22.13.0 || >=24).
    // ES2020 understated the runtime the same way @types/node ^18 did: it
    // withheld built-ins Node has supported for years, so `Array#at` only
    // compiled because older @types/node happened to declare it. Newer
    // @types/node stopped, surfacing as TS2550 in tests — and only in tests,
    // since `include` here covers src alone and ts-jest compiles the rest.
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "typeRoots": ["node_modules/@types"],
    "paths": {
      "@iris/visual": ["./src/visual/index"],
      "@iris/a11y": ["./src/a11y/index"],
      "@iris/utils": ["./src/utils/index"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.test.ts",
    "**/__tests__/**/*",
    "jest.setup.ts"
  ]
}
