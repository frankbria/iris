{
  "name": "iris-suite",
  "version": "0.0.1",
  "description": "Interface Recognition & Interaction Suite - AI-powered UI understanding and testing",
  "keywords": [
    "ai",
    "ui",
    "testing",
    "automation",
    "playwright",
    "vision",
    "developer-tools"
  ],
  "homepage": "https://github.com/frankbria/iris",
  "bugs": "https://github.com/frankbria/iris/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankbria/iris.git"
  },
  "main": "dist/cli.js",
  "bin": {
    "iris": "./dist/cli.js",
    "iris-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    ".mcp.json.example"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "jest",
    "start": "ts-node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "author": "FRANK BRIA <frank@frankbria.com>",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@axe-core/playwright": "^4.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "aria-query": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "openai": "^6.45.0",
    "p-limit": "^5.0.0",
    "picomatch": "^4.0.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "simple-git": "^3.20.0",
    "ws": "^8.13.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.2.0"
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.62.0"
  }
}
