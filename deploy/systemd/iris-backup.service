# Encrypted Postgres + master key backup (issue #274, deploy/backup.sh).
# Installed by the operator: docs/runbook-production.md, "Backups and restore".
#
# Runs as root (the master key is readable by uid 1001 only), so everything it runs or
# reads as configuration is root-owned and outside the deploy user's tree: the script
# is a reviewed copy in /usr/local/sbin, settings and recipients are in /etc/iris.
[Unit]
Description=IRIS production backup
Wants=network-online.target
After=network-online.target docker.service
OnFailure=iris-backup-failed.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/iris-backup
Environment=DEPLOY_DIR=/opt/iris-production
# Optional settings (BACKUP_RCLONE_REMOTE, BACKUP_KEEP_DAYS, ...): root:root 0600.
EnvironmentFile=-/etc/iris/backup.env
# rclone's config lives with the other settings; rclone may rewrite it (token refresh).
Environment=RCLONE_CONFIG=/etc/iris/rclone.conf
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
# Sandboxing. The docker CLI only connects to /run/docker.sock, which works on a
# read-only file system; the only writes are the backups and rclone's config.
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/iris -/etc/iris
